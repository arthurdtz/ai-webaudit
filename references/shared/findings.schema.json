{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arthurdtz/ai-webaudit/references/shared/findings.schema.json",
  "title": "AI WebAudit findings.json",
  "description": "Metadados do run + array de achados (SPEC §7). Regras semânticas que o JSON Schema não expressa (prefixo do id = prefixo da área, ids únicos, related_ids existentes, segredos mascarados) são checadas por scripts/validate-findings.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "skill", "arguments", "target_path", "git", "stack",
    "collection_modes", "areas_selected", "areas_excluded", "tools",
    "not_tested", "generated_at", "findings"
  ],
  "properties": {
    "run_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}_\\d{4}$" },
    "skill": { "enum": ["audit", "pre-launch", "optimize", "fix"] },
    "arguments": { "type": "string", "description": "Argumentos como digitados pelo usuário (string vazia se nenhum)." },
    "target_path": { "type": "string", "minLength": 1 },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_repo"],
      "properties": {
        "is_repo": { "type": "boolean" },
        "commit": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": true,
      "required": ["framework"],
      "properties": {
        "framework": { "type": "string" },
        "language": { "type": "string" },
        "site_type": { "type": "string" },
        "hosting": { "type": "string" }
      }
    },
    "collection_modes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "enum": ["estatica", "ativa-local", "ativa-remota"] }
    },
    "areas_selected": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/areaPrefix" }
    },
    "areas_excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "reason"],
        "properties": {
          "area": { "$ref": "#/$defs/areaPrefix" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": ["string", "null"] },
          "status": { "enum": ["ok", "failed", "skipped", "unavailable"] },
          "error": { "type": "string" }
        }
      }
    },
    "not_tested": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "description", "reason"],
        "properties": {
          "area": { "$ref": "#/$defs/areaPrefix" },
          "check_id": { "$ref": "#/$defs/checkId" },
          "description": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "areaPrefix": {
      "enum": [
        "SEO", "GEO", "AEO", "AIO", "CRO", "QA", "ANL", "PERF",
        "A11Y", "PRIV", "LOC", "OPS", "CONT", "API", "SEC"
      ]
    },
    "findingId": { "type": "string", "pattern": "^WA-(SEO|GEO|AEO|AIO|CRO|QA|ANL|PERF|A11Y|PRIV|LOC|OPS|CONT|API|SEC)-\\d{3}$" },
    "checkId": { "type": "string", "pattern": "^(SEO|GEO|AEO|AIO|CRO|QA|ANL|PERF|A11Y|PRIV|LOC|OPS|CONT|API|SEC)-C\\d{2}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["codigo", "configuracao", "comando", "http", "ferramenta", "captura", "ausencia"] },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "snippet": { "type": "string", "description": "Trecho curto. Segredos mascarados (máx. 4 primeiros caracteres + ****)." },
        "command": { "type": "string" },
        "output_excerpt": { "type": "string" },
        "raw_ref": { "type": "string", "description": "Caminho relativo ao run dir, ex.: raw/lighthouse-home-mobile.json" }
      },
      "anyOf": [
        { "required": ["file"] },
        { "required": ["command"] },
        { "required": ["raw_ref"] }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "check_id", "area", "title", "description", "severity", "nature",
        "verification", "evidence", "impact", "recommendation",
        "validation_criteria", "effort", "fix_status", "related_ids", "tradeoffs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/findingId" },
        "check_id": { "$ref": "#/$defs/checkId" },
        "area": { "$ref": "#/$defs/areaPrefix" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["CRITICO", "IMPORTANTE", "MELHORIA", "OPCIONAL"] },
        "nature": { "enum": ["CONFIRMADO", "RISCO_POTENCIAL", "PREVENTIVO"] },
        "verification": { "enum": ["estatica", "ativa-local", "ativa-remota", "manual-pendente"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "impact": { "type": "string", "minLength": 1 },
        "recommendation": { "type": "string", "minLength": 1 },
        "validation_criteria": { "type": "string", "minLength": 1 },
        "effort": { "enum": ["P", "M", "G"] },
        "fix_status": { "enum": ["aberto", "autorizado", "corrigido", "validado", "falhou-validacao", "descartado"] },
        "related_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/findingId" } },
        "tradeoffs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "$comment": "CRÍTICO exige CONFIRMADO, ou risco de segurança/privacidade (SEC, API, PRIV) com evidência concreta no código (arquivo + trecho).",
          "if": { "properties": { "severity": { "const": "CRITICO" } }, "required": ["severity"] },
          "then": {
            "anyOf": [
              { "properties": { "nature": { "const": "CONFIRMADO" } } },
              {
                "properties": {
                  "nature": { "const": "RISCO_POTENCIAL" },
                  "area": { "enum": ["SEC", "API", "PRIV"] },
                  "evidence": {
                    "contains": { "type": "object", "required": ["file", "snippet"] }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
